---
# ansible-lint config for dc1.azure (Phase 5 CI gate).
# The repo's playbooks talk to AAP/Azure via collections that aren't installed
# in CI, so run offline and mock those modules/roles — ansible-lint then checks
# style/structure deterministically without needing the Hub token in CI.
profile: production
offline: true

exclude_paths:
  - collections/
  - .terraform/
  - .git/

# Modules used by the playbooks but not installed in the CI runner.
mock_modules:
  - ansible.controller.host
  - ansible.controller.group
  - ansible.controller.credential
  - ansible.controller.project
  - ansible.controller.workflow_launch   # Phase 9 launcher (playbooks/launch_workflow.yml)
  - ansible.platform.host
  - ansible.platform.token
  # ansible.windows — used by website_setup_azure role; not installed in CI
  - ansible.windows.win_service
  - ansible.windows.win_feature
  - ansible.windows.win_reboot
  - ansible.windows.win_wait_for
  - ansible.windows.win_template
  - ansible.windows.win_copy
  - ansible.windows.win_file
  - ansible.windows.win_uri
  - ansible.windows.win_package
  - ansible.windows.win_command
  - ansible.windows.win_service_info
  - ansible.windows.win_powershell
  # servicenow.itsm — used by playbooks/servicenow/* (Phase 8); not installed in CI
  - servicenow.itsm.configuration_item
  - servicenow.itsm.api
  - servicenow.itsm.api_info
  - servicenow.itsm.incident
  # ansible.posix — used by linux_configure role (Phase 17); not installed in CI
  - ansible.posix.firewalld
  # ansible.eda — used by load.yml EDA activation disable/re-enable (AB#140)
  - ansible.eda.rulebook_activation

mock_roles:
  - infra.aap_configuration.dispatch
  - infra.aap_configuration.controller_role_team_assignments   # Phase 9 (load.yml explicit include_role)
