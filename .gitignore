# Terraform — local working dirs and state
# (.terraform.lock.hcl IS committed — needed for reproducible provider versions)
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform — variable files likely to contain sensitive data
# (commit *.tfvars.example for documentation only)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform — override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform — CLI configuration
.terraformrc
terraform.rc

# Ansible — installed collections (declared in collections/requirements.yml)
collections/ansible_collections/

# Ansible — local cache dirs created by ansible / ansible-lint
.ansible/

# Ansible — vault password files and local secrets
.vault_pass
.vault_password
*.vault_pass

# direnv-loaded local environment; contains Azure SP credentials per developer.
# Copy .envrc.example to .envrc and fill in your values.
.envrc

# Local dev environment — fill in from docs/dev-environment.sh.example (never commit)
docs/dev-environment.sh
docs/dev-environment.md

# Claude Code per-project state (memory, transcripts, settings) — ignored,
# EXCEPT repo-based skills, which ship with the repo (decision 2026-05-26).
.claude/*
!.claude/skills/

# ansible-builder — build context dir created during `ansible-builder build`
# (.tgz artifacts and the unpacked context are build-time only; not needed in VCS)
context/

# OS / editor cruft
.DS_Store
*.swp
*~
__pycache__/
*.py[cod]
