#!/usr/bin/env bash
# docs/dev-environment.sh — GITIGNORED, never commit
#
# Copy this file (highlight and paste to terminal):
#   cp docs/dev-environment.sh.example docs/dev-environment.sh
#
# Fill in your values, then:
#
#   source docs/dev-environment.sh && \
#   ansible-playbook -i aap_config/inventory/ aap_config/load.yml
#
# All exports and the ansible-playbook command must be in one shell invocation —
# env vars do not persist across separate terminal commands or tool calls.

# --- AAP -------------------------------------------------------------------
export AAP_HOSTNAME=https://REPLACE_ME_AAP_HOSTNAME
export AAP_VALIDATE_CERTS=false                # set true for a trusted cert
# load.yml / validate.yml mint a short-lived token from these and delete it
# afterward — no stored token to expire (see docs/INSTALL.md §4).
export AAP_CONTROLLER_USERNAME=admin
export AAP_CONTROLLER_PASSWORD=REPLACE_ME_AAP_ADMIN_PASSWORD

# OPTIONAL escape hatch — only needed for an SSO/MFA-backed AAP where minting
# from username/password is blocked. Create a token in the AAP UI and export it;
# load.yml will use it as-is and NOT delete it. Leave unset otherwise.
# export AAP_TOKEN=REPLACE_ME_AAP_TOKEN

# Required separately — ansible.controller.* async workers read these directly
# and fall back to 127.0.0.1 if absent (see docs/INSTALL.md §5).
export CONTROLLER_HOST=$AAP_HOSTNAME
export CONTROLLER_OAUTH_TOKEN=${AAP_TOKEN:-}
export CONTROLLER_VERIFY_SSL=false

# --- Secrets you choose (keep these in sync with each other) ---------------
export DC1_AZURE_VAULT_PASSWORD=REPLACE_ME_VAULT_PASSWORD    # DC1.Azure - Vault credential
export WINDOWS_ADMIN_USERNAME=demoadmin                       # matches Terraform admin_username default
export WINDOWS_ADMIN_PASSWORD=REPLACE_ME_WINDOWS_PASSWORD    # Azure-complex: 12-72 chars,
                                                              # 3 of: upper / lower / digit / symbol
export DC1_AZURE_DEFAULT_PASSWD=REPLACE_ME_DEMO_PASSWD       # password for devops + ansible-svc
                                                              # accounts created on the VM

# --- Azure Service Principal (from RHDP Azure open environment) ------------
export AZURE_SUBSCRIPTION_ID=REPLACE_ME_SUBSCRIPTION_ID
export AZURE_TENANT_ID=REPLACE_ME_TENANT_ID
export AZURE_CLIENT_ID=REPLACE_ME_CLIENT_ID
export AZURE_CLIENT_SECRET=REPLACE_ME_CLIENT_SECRET
export AZURE_RESOURCE_GROUP=REPLACE_ME_RHDP_RG                # e.g. openenv-xxxxx
export AZURE_LOCATION=eastus
export AZURE_TF_STORAGE_ACCOUNT=REPLACE_ME_TF_STATE_SA        # must exist before load.yml
                                                               # see docs/INSTALL.md §2.6

# --- Azure DevOps PAT -------------------------------------------------------
export ADO_PAT=REPLACE_ME_ADO_PAT

# --- ServiceNow (Phase 8) ----------------------------------------------------
# SN_* are consumed by the DC1.Azure - ServiceNow credential (ServiceNow ITSM
# Credential type) for the AAP->SNow RITM/CMDB/incident callback.
# See docs/servicenow-integration.md.
# export SN_HOST=https://REPLACE_ME_SNOW_INSTANCE.service-now.com
# export SN_USERNAME=REPLACE_ME_SNOW_USER
# export SN_PASSWORD=REPLACE_ME_SNOW_PASSWORD
#
# EDA_EVENT_STREAM_TOKEN is a strong RANDOM value YOU mint (not received). The
# same value goes two places and must match: the AAP "ServiceNow Event Stream"
# credential (set at load time from this var) AND the Authorization: Bearer
# header of the ServiceNow Outbound REST Message. Generate with e.g.
#   openssl rand -hex 32
# export EDA_EVENT_STREAM_TOKEN=REPLACE_ME_EVENT_STREAM_TOKEN

# --- Automation Analytics / Insights — Automation Calculator -----------------
# Red Hat SERVICE ACCOUNT creds (client ID + secret), created at
# https://console.redhat.com/iam/service-accounts. They authenticate AAP's
# analytics upload to console.redhat.com, which feeds the Automation Calculator
# (ROI / planner). Consumed by aap_config/files/controller_settings.yml.
# Leave unset to skip analytics. After loading, force a first upload from the
# AAP UI (Settings -> Subscription) so the calculator has data to chart.
export REDHAT_SUBSCRIPTIONS_CLIENT_ID=REPLACE_ME_RH_SVC_ACCOUNT_CLIENT_ID
export REDHAT_SUBSCRIPTIONS_CLIENT_SECRET=REPLACE_ME_RH_SVC_ACCOUNT_CLIENT_SECRET

# --- Self-Service Portal demo users (Phase 9) --------------------------------
# Passwords for the two Self-Service Portal demo personas created by load.yml
# (gateway_users.yml): dev-lead (admin) and jr-dev (least-privilege). They log
# into the portal with these. Choose your own values.
export DC1_AZURE_DEV_ADMIN_PASSWORD=REPLACE_ME_DEV_LEAD_PASSWORD
export DC1_AZURE_JR_DEV_PASSWORD=REPLACE_ME_JR_DEV_PASSWORD
# RHDH-based Ansible self-service portal route (separate OpenShift route, NOT the
# AAP gateway). Pattern: https://rhaap-portal-aap-portal.apps.<cluster>
export SELF_SERVICE_PORTAL_URL=https://rhaap-portal-aap-portal.apps.REPLACE_ME_CLUSTER_DOMAIN

# --- Linux VM (Phase 16) -----------------------------------------------------
# SSH key pair for the Linux VM. Use the same key as your laptop so you can SSH
# in directly after provisioning. The public key goes into the VM (Terraform);
# the private key goes into the DC1.Azure - Linux Machine credential (AAP).
export LINUX_SSH_PUBLIC_KEY="$(cat ~/.ssh/id_rsa.pub)"
export LINUX_SSH_PRIVATE_KEY="$(cat ~/.ssh/id_rsa)"
# export LINUX_ADMIN_USERNAME=azureuser   # default; override if needed

# --- Dynatrace OneAgent (Issue #1) -------------------------------------------
# Dynatrace SaaS tenant URL (the .live. URL, not .apps.).
export DT_API_HOST=https://REPLACE_ME_ENV_ID.live.dynatrace.com
# PaaS token (installer download token) — generate in Dynatrace UI:
#   Deploy Dynatrace > Download OneAgent > choose your OS > "Create token"
# This is NOT the API token or OAuth client secret — it's a separate token type
# scoped only to installer downloads.
export DT_PAAS_TOKEN=REPLACE_ME_DT_PAAS_TOKEN
# Classic access token (dt0c01.*) for Dynatrace API v2 — generate in Dynatrace UI:
#   Settings > Access tokens > Generate new token. Required scopes:
#     problems.read, problems.write   (RCA + problem management — AB#154)
#     settings.read, settings.write   (maintenance windows — AB#153 teardown)
#     entities.read                   (resolve host group -> entity IDs — AB#153)
# This is NOT the PaaS token — it's a separate token type for API v2 access.
# NOTE: settings.write is tenant-wide; on a shared/production tenant prefer a
# dedicated least-privilege token (see playbooks/roles/dt_decommission/README.md).
export DT_API_TOKEN=REPLACE_ME_DT_API_TOKEN

# --- AAP MCP Server (AI agent integration) -----------------------------------
# The MCP server lets AI coding assistants (Claude Code, Cursor) query and
# control AAP via the Model Context Protocol. Requires AAP 2.7+ with the MCP
# server component enabled. Deploy with `/mcp-server` skill or see
# .claude/skills/mcp-server/SKILL.md. The route appears after deployment:
#   oc get routes -n aap | grep mcp
export AAP_MCP_URL=https://REPLACE_ME_MCP_ROUTE/mcp
export AAP_MCP_TOKEN=REPLACE_ME_AAP_MCP_TOKEN   # gateway token (Read scope minimum)

# --- Optional overrides (safe to leave commented out) ----------------------
# export AH_HOSTNAME=$AAP_HOSTNAME           # Hub hostname; defaults to AAP gateway host (correct for AAP 2.5)
# export DC1_AZURE_EE='DC1.Azure - EE'       # EE name; load.yml creates this automatically
# export DC1_AZURE_EE_IMAGE='quay.io/zigfreed/dc1-azure-ee:latest'  # Hub-less smoke test only
