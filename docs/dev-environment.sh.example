#!/usr/bin/env bash
# docs/dev-environment.sh — GITIGNORED, never commit
#
# Copy this file (highlight and paste to terminal):
#   cp docs/dev-environment.sh.example docs/dev-environment.sh
#
# Fill in your values, then:
#
#   source docs/dev-environment.sh && \
#   ansible-playbook -i aap_config/inventory/ aap_config/load.yml
#
# All exports and the ansible-playbook command must be in one shell invocation —
# env vars do not persist across separate terminal commands or tool calls.

# --- AAP -------------------------------------------------------------------
export AAP_HOSTNAME=https://REPLACE_ME_AAP_HOSTNAME
export AAP_TOKEN=REPLACE_ME_AAP_TOKEN          # create per docs/INSTALL.md §4; delete after load.yml
export AAP_VALIDATE_CERTS=false                # set true for a trusted cert
export AAP_CONTROLLER_USERNAME=admin
export AAP_CONTROLLER_PASSWORD=REPLACE_ME_AAP_ADMIN_PASSWORD

# Required separately — ansible.controller.* async workers read these directly
# and fall back to 127.0.0.1 if absent (see docs/INSTALL.md §5).
export CONTROLLER_HOST=$AAP_HOSTNAME
export CONTROLLER_OAUTH_TOKEN=$AAP_TOKEN
export CONTROLLER_VERIFY_SSL=false

# --- Secrets you choose (keep these in sync with each other) ---------------
export DC1_AZURE_VAULT_PASSWORD=REPLACE_ME_VAULT_PASSWORD    # DC1.Azure - Vault credential
export WINDOWS_ADMIN_USERNAME=demoadmin                       # matches Terraform admin_username default
export WINDOWS_ADMIN_PASSWORD=REPLACE_ME_WINDOWS_PASSWORD    # Azure-complex: 12-72 chars,
                                                              # 3 of: upper / lower / digit / symbol
export DC1_AZURE_DEFAULT_PASSWD=REPLACE_ME_DEMO_PASSWD       # password for devops + ansible-svc
                                                              # accounts created on the VM

# --- Azure Service Principal (from RHDP Azure open environment) ------------
export AZURE_SUBSCRIPTION_ID=REPLACE_ME_SUBSCRIPTION_ID
export AZURE_TENANT_ID=REPLACE_ME_TENANT_ID
export AZURE_CLIENT_ID=REPLACE_ME_CLIENT_ID
export AZURE_CLIENT_SECRET=REPLACE_ME_CLIENT_SECRET
export AZURE_RESOURCE_GROUP=REPLACE_ME_RHDP_RG                # e.g. openenv-xxxxx
export AZURE_LOCATION=eastus
export AZURE_TF_STORAGE_ACCOUNT=REPLACE_ME_TF_STATE_SA        # must exist before load.yml
                                                               # see docs/INSTALL.md §2.6

# --- Azure DevOps PAT -------------------------------------------------------
export ADO_PAT=REPLACE_ME_ADO_PAT

# --- ServiceNow (Phase 8) ----------------------------------------------------
# SN_* are consumed by the DC1.Azure - ServiceNow credential (ServiceNow ITSM
# Credential type) for the AAP->SNow RITM/CMDB/incident callback.
# See docs/servicenow-integration.md.
# export SN_HOST=https://REPLACE_ME_SNOW_INSTANCE.service-now.com
# export SN_USERNAME=REPLACE_ME_SNOW_USER
# export SN_PASSWORD=REPLACE_ME_SNOW_PASSWORD
#
# EDA_EVENT_STREAM_TOKEN is a strong RANDOM value YOU mint (not received). The
# same value goes two places and must match: the AAP "ServiceNow Event Stream"
# credential (set at load time from this var) AND the Authorization: Bearer
# header of the ServiceNow Outbound REST Message. Generate with e.g.
#   openssl rand -hex 32
# export EDA_EVENT_STREAM_TOKEN=REPLACE_ME_EVENT_STREAM_TOKEN

# --- Optional overrides (safe to leave commented out) ----------------------
# export AH_HOSTNAME=$AAP_HOSTNAME           # Hub hostname; defaults to AAP gateway host (correct for AAP 2.5)
# export DC1_AZURE_EE='DC1.Azure - EE'       # EE name; load.yml creates this automatically
# export DC1_AZURE_EE_IMAGE='quay.io/zigfreed/dc1-azure-ee:latest'  # Hub-less smoke test only
